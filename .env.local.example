# ============================================================
# HARDWARE STORE FRONTEND - ENVIRONMENT CONFIGURATION
# ============================================================
# IMPORTANT: Copy this to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# SECURITY NOTES:
# - NEXT_PUBLIC_* variables are EXPOSED to the browser — never put secrets here
# - STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY are server-side only
# ============================================================

# Supabase — NEXT_PUBLIC_ keys are safe to expose (anon key only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role — SERVER SIDE ONLY, never use NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — publishable key is safe to expose, secret key is server-side only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin API Key — must match backend ADMIN_API_KEY
# Used to authenticate admin operations on Next.js API routes
ADMIN_API_KEY=your_admin_api_key_matching_backend
