# ============================================================
# HARDWARE STORE BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================
# IMPORTANT: Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hardware_store?schema=public"

# JWT Secrets — MUST be at least 32 chars, use crypto.randomBytes(64)
JWT_ACCESS_SECRET="REPLACE_WITH_STRONG_64_CHAR_HEX_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_64_CHAR_HEX_SECRET"

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Admin API Key — used to protect admin-only endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY="REPLACE_WITH_STRONG_32_CHAR_HEX_KEY"

# Cloudinary — for product image uploads
CLOUDINARY_CLOUD_NAME="your_cloudinary_name"
CLOUDINARY_API_KEY="your_cloudinary_key"
CLOUDINARY_API_SECRET="your_cloudinary_secret"

# Razorpay — for payment processing
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
